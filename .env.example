# Leave unset for local disk storage (data/posters + data/catalog.json).
# Set on the VM to use Cloud Storage for uploads only.
# GCS_BUCKET_NAME=your-demo-netflix-bucket

# Optional on GCE if project ID is not detected
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# App defaults this to "none" in code (HTTP metadata). Uncomment to re-enable mTLS.
# GCE_METADATA_MTLS_MODE=default

# Optional: override local data directory (local mode only)
# DATA_DIR=/path/to/data
